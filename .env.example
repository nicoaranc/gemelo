# Copiar a .env y completar. No commitear .env.
ANTHROPIC_API_KEY=
GATEWAY_MODE=replay

# Proveedor de sandboxes: local (Docker) | e2b (microVMs en E2B). Por defecto: local.
SANDBOX_PROVIDER=local
# Key de E2B. Solo la usa el orquestador; nunca entra a un sandbox. Necesaria si SANDBOX_PROVIDER=e2b.
E2B_API_KEY=
