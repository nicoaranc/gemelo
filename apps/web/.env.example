# URL del orquestador (FastAPI). En Render, la URL interna o pública del servicio api.
GEMELO_API_URL=http://127.0.0.1:8000
# Mismo valor que GEMELO_API_TOKEN del orquestador. Vacío si la API está abierta (local).
GEMELO_API_TOKEN=
# Contraseña compartida del equipo para entrar al panel
PANEL_PASSWORD=cambia-esto
# Llave para firmar la cookie de sesión (32+ caracteres al azar)
PANEL_SECRET=
